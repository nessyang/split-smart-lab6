@startuml SplitSmartSystemContext
title SplitSmart System Context
left to right direction
skinparam componentStyle rectangle

actor "Account holder" as user
actor "Group organizer" as organizer
actor "Reviewer" as reviewer
actor "Report viewer" as reportViewer

rectangle "SplitSmart" as system {
  usecase "Manage account and groups" as account
  usecase "Submit and review expenses" as expenses
  usecase "Settle pairwise balances" as balances
  usecase "View reports and notifications" as reports
}

user --> account
user --> expenses
user --> balances
user --> reports
organizer --> account
reviewer --> expenses
reportViewer --> reports

cloud "Future shared service boundary" as future {
  component "Web client" as web
  component "Android client" as android
  component "iOS client" as ios
  database "Shared product data" as sharedData
}

web ..> system : target client
android ..> system : target client
ios ..> system : target client
system ..> sharedData : target shared persistence

note right of system
  Approved MVP: Java Swing desktop
  with local persistence.
  Full web/mobile delivery remains
  separate product scope.
end note
@enduml
