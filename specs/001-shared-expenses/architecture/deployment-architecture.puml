@startuml SplitSmartDeploymentArchitecture
title SplitSmart Deployment Architecture
left to right direction
skinparam componentStyle rectangle

node "MVP desktop host" as desktop {
  artifact "Java 21 runtime" as jvm
  component "SplitSmart Swing application" as app
  database "File-backed H2 database" as h2
  folder "Receipt images and local config" as files
  jvm -- app
  app --> h2 : JDBC
  app --> files : local file access
}

cloud "Future shared deployment" as cloud {
  node "Web/API service" as apiNode {
    component "REST API" as api
    component "Application services" as services
  }
  database "Shared relational database" as sharedDb
  folder "Object storage" as objectStore
  api --> services
  services --> sharedDb
  services --> objectStore
}

node "Supported client targets" as clients {
  artifact "Web browser" as web
  artifact "Android app" as android
  artifact "iOS app" as ios
}

web ..> api : future HTTPS
android ..> api : future HTTPS
ios ..> api : future HTTPS

note bottom of desktop
  This is the approved MVP deployment.
end note
note bottom of cloud
  Target architecture only; not delivered by the Swing MVP.
end note
@enduml
