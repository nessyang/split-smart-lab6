@startuml SplitSmartConsolidatedSecurity
title SplitSmart Consolidated Security Architecture
left to right direction
skinparam componentStyle rectangle

actor user
component "Web / Android / iOS client" as client
component "WAF and API gateway" as edge
component "Authentication and token service" as auth
component "Password hashing (Argon2id)" as hashing
component "Access-token expiry" as access
component "Refresh-token rotation/revocation" as refresh
component "Single-use reset-token service" as reset
component "Authorization policy" as policy
component "Java 21 Spring Boot modules" as backend
database "PostgreSQL" as db
database "Token/session store" as tokenStore
folder "Private receipt storage" as receipts
component "Audit and security events" as audit
cloud "Email provider" as email

user --> client : credentials / access token
client --> edge : TLS
edge --> auth : authenticate / validate
auth --> hashing : verify password hash
auth --> access : issue short-lived token
auth --> refresh : rotate refresh token
refresh --> tokenStore : store hash/revocation
auth --> reset : verify single-use reset token
reset --> tokenStore : expiry/consumption
edge --> backend : authenticated request
backend --> policy : account, group, role
policy --> db : membership lookup
backend --> db : parameterized transaction
backend --> receipts : short-lived signed URL
backend --> audit : actor, action, time
auth --> email : verification/reset
access --> client : expires / rejected after expiry

note right of policy
Default deny.
Membership gates group data.
Organizer/reviewer roles gate approval.
Receipt access is separately authorized.
end note
@enduml
